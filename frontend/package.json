    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@lezer/markdown": "^1.7.2",
    "@primer/css": "^22.3.1",
    "@primer/primitives": "^11.10.0",
    "@types/node": "^26.5.1",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "katex": "^0.18.7",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@tabler/icons": "^3.46.0",
